#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/type
<http://purl.org/dc/terms/type> rdf:type owl:ObjectProperty .


###  http://purl.org/spar/datacite/hasCreatorList
<http://purl.org/spar/datacite/hasCreatorList> rdf:type owl:ObjectProperty ;
                                               rdfs:domain [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/spar/datacite/hasIdentifier> ;
                                                             owl:someValuesFrom <http://purl.org/spar/datacite/ResourceIdentifier>
                                                           ] ;
                                               rdfs:range <http://purl.org/co/List> ;
                                               rdfs:comment "This property allows one to specify the list of the creators of a certain resource."@en ;
                                               rdfs:label "has creator list"@en .


###  http://purl.org/spar/datacite/hasDescription
<http://purl.org/spar/datacite/hasDescription> rdf:type owl:ObjectProperty ;
                                               rdfs:domain [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/spar/datacite/hasIdentifier> ;
                                                             owl:someValuesFrom <http://purl.org/spar/datacite/ResourceIdentifier>
                                                           ] ;
                                               rdfs:range [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/spar/datacite/hasDescriptionType> ;
                                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                                          ] ;
                                               <http://purl.org/vocab/vann/example> """
        :my-resource
            datacite:hasDescription :my-resource-additional-info .
        :my-resource-additional-info
            literal:hasLiteralValue \"A textual description\" .
    """ ;
                                               rdfs:comment "An object property permitting specification of an entity used to describe a resource."@en ;
                                               rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                               rdfs:label "has description"@en .


###  http://purl.org/spar/datacite/hasDescriptionType
<http://purl.org/spar/datacite/hasDescriptionType> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://purl.org/dc/terms/type> ;
                                                   rdfs:domain [ rdf:type owl:Restriction ;
                                                                 owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/hasDescription>
                                                                                ] ;
                                                                 owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty <http://purl.org/spar/datacite/hasIdentifier> ;
                                                                                     owl:someValuesFrom <http://purl.org/spar/datacite/ResourceIdentifier>
                                                                                   ]
                                                               ] ;
                                                   rdfs:range <http://purl.org/spar/datacite/DescriptionType> ;
                                                   <http://purl.org/vocab/vann/example> """
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    """ ;
                                                   rdfs:comment "An object property permitting specification of the type of description used to describe a resource."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                   rdfs:label "has description type"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "A type of description is defined as an individual of the class datacite:DescriptionType from the DataCite controlled list of Abstract (datacite:abstract), SeriesInformation (datacite:series-information), TableOfContent (datacite:table-of-content) and Other (datacite:other)."@en .


###  http://purl.org/spar/datacite/hasGeneralResourceType
<http://purl.org/spar/datacite/hasGeneralResourceType> rdf:type owl:ObjectProperty ;
                                                       rdfs:subPropertyOf <http://purl.org/dc/terms/type> ;
                                                       rdfs:domain [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/spar/datacite/hasIdentifier> ;
                                                                     owl:someValuesFrom <http://purl.org/spar/datacite/ResourceIdentifier>
                                                                   ] ;
                                                       rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-resource
            datacite:hasGeneralResourceType dcmitype:Dataset .
    """ ;
                                                       rdfs:comment "An object property permitting specification of the general type of a resource, defined from the DataCite controlled list."@en ;
                                                       rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                       rdfs:label "has general resource type"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> """
The DataCite controlled list includes: 

- dcmitype:MovingImage;
- fabio:Book;
- fabio:BookChapter;
- dcmitype:Collection;
- fabio:LaboratoryNotebook;
- fabio:ConferencePaper;
- fabio:ConferenceProceedings;
- fabio:ResourcePaper;
- dcmitype:Dataset;
- fabio:Thesis;
- dcmitype:Event;
- dcmitype:StillImage;
- dcmitype:InteractiveResource;
- fabio:Journal;
- fabio:JournalArticle;
- fabio:Model;
- fabio:DataManagementPlan;
- dcmitype:PhysicalObject;
- fabio:ConferencePoster;
- fabio:Preprint;
- fabio:Presentation;
- fabio:ProjectPlan;
- fabio:ReportDocument;
- dcmitype:Service;
- dcmitype:Software;
- dcmitype:Sound;
- fabio:TechnicalStandard;
- fabio:Report;
- dcmitype:Text;
- fabio:Workflow;
- frbr:Endeavour.

All the prefixes used here refer to external ontologies, i.e., DC Metadata Terms (dcmitype: http://purl.org/dc/dcmitype/), FaBiO (fabio: http://purl.org/spar/fabio/), and FRBR (frbr: http://purl.org/vocab/frbr/core#).
    """@en .


###  http://purl.org/spar/datacite/hasIdentifier
<http://purl.org/spar/datacite/hasIdentifier> rdf:type owl:ObjectProperty ,
                                                       owl:InverseFunctionalProperty ;
                                              rdfs:range <http://purl.org/spar/datacite/Identifier> ;
                                              <http://purl.org/vocab/vann/example> """
        :my-resource
            datacite:hasIdentifier :my-resource-pri .
    """ ;
                                              rdfs:comment "An object property specifying a datacite:Identifier that provides a unique identifier for the entity (either a funder, a person or a resource)."@en ;
                                              rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                              rdfs:label "has identifier"@en .


###  http://purl.org/spar/datacite/hasRelationCharacterization
<http://purl.org/spar/datacite/hasRelationCharacterization> rdf:type owl:ObjectProperty ;
                                                            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> ;
                                                            rdfs:domain <http://purl.org/spar/datacite/QualifiedRelation> ;
                                                            <http://purl.org/vocab/vann/example> """
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationCharacterization cito:isCitedBy .
    """ ;
                                                            rdfs:comment "An object property defining the specific nature or type of the reified relation."@en ;
                                                            rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                            rdfs:label "has relation characterization"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "This property uses as range an existing property via OWL2 punning, according to which it becomes possible to use an object property as the object of an OWL assertion. In such cases of OWL punning, the object properties are simultaneously considered both as normal object properties and also as proper named individuals of the class owl:Thing."@en .


###  http://purl.org/spar/datacite/hasRelationObject
<http://purl.org/spar/datacite/hasRelationObject> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> ;
                                                  rdfs:domain <http://purl.org/spar/datacite/QualifiedRelation> ;
                                                  <http://purl.org/vocab/vann/example> """
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationObject :my-article .
    """ ;
                                                  rdfs:comment "An object property linking a reified relation to its object resource."@en ;
                                                  rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                  rdfs:label "has relation object"@en .


###  http://purl.org/spar/datacite/hasRelationSubject
<http://purl.org/spar/datacite/hasRelationSubject> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> ;
                                                   rdfs:domain <http://purl.org/spar/datacite/QualifiedRelation> ;
                                                   <http://purl.org/vocab/vann/example> """
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationSubject :my-resource .
    """ ;
                                                   rdfs:comment "An object property linking a reified relation to its subject resource."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                   rdfs:label "has relation subject"@en .


###  http://purl.org/spar/datacite/usesIdentifierScheme
<http://purl.org/spar/datacite/usesIdentifierScheme> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/spar/datacite/Identifier> ;
                                                     rdfs:range <http://purl.org/spar/datacite/IdentifierScheme> ;
                                                     <http://purl.org/vocab/vann/example> """
        :my-resource-id
            datacite:usesIdentifierScheme datacite:doi .
    """ ;
                                                     rdfs:comment "An object property permitting specification of the identifier scheme used to provide the identifier for an entity (either a funder, a person or a resource)."@en ;
                                                     rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                     rdfs:label "uses identifier scheme"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "An identifier scheme is defined as an individual of the class datacite:IdentifierScheme."@en .


###  http://purl.org/spar/datacite/usesMetadataScheme
<http://purl.org/spar/datacite/usesMetadataScheme> rdf:type owl:ObjectProperty ;
                                                   rdfs:range <http://purl.org/spar/datacite/MetadataScheme> ;
                                                   <http://purl.org/vocab/vann/example> """
        :related-document a fabio:MetadataDocument ;
            datacite:usesMetadataScheme datacite:spar .
    """ ;
                                                   rdfs:comment "The link between a metadata document and the scheme followed for creating metadata."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                   rdfs:label "uses metadata scheme"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/spar/fabio/hasURL
<http://purl.org/spar/fabio/hasURL> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/co/List
<http://purl.org/co/List> rdf:type owl:Class .


###  http://purl.org/spar/datacite/AgentIdentifier
<http://purl.org/spar/datacite/AgentIdentifier> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.org/spar/datacite/Identifier> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                  owl:allValuesFrom <http://purl.org/spar/datacite/AgentIdentifier>
                                                                ] ;
                                                owl:disjointWith <http://purl.org/spar/datacite/ResourceIdentifier> ;
                                                <http://purl.org/vocab/vann/example> """
        :essepuntato a datacite:AgentIdentifier ;
            literal:hasLiteralValue \"https://github.com/essepuntato\" .
    """ ;
                                                rdfs:comment "An identifier that uniquely identities an individual agent."@en ;
                                                rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                rdfs:label "agent identifier"@en ;
                                                <http://www.w3.org/2004/02/skos/core#scopeNote> "An agent identifier belongs to a particular identifier scheme, specified by an individual within the class datacite:AgentIdentifierScheme (or any of its subclasses)."@en .


###  http://purl.org/spar/datacite/AgentIdentifierScheme
<http://purl.org/spar/datacite/AgentIdentifierScheme> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.org/spar/datacite/IdentifierScheme> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/usesIdentifierScheme>
                                                                                       ] ;
                                                                        owl:someValuesFrom <http://purl.org/spar/datacite/AgentIdentifier>
                                                                      ] ;
                                                      <http://purl.org/vocab/vann/example> """
        :silvio-peroni-id
            datacite:usesIdentifierScheme datacite:github ;
            literal:hasLiteralValue \"essepuntato\" .
    """ ;
                                                      rdfs:comment "The identifier scheme used to identify an agent."@en ;
                                                      rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                      rdfs:label "agent identifier scheme"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of its sub-classes."@en .


###  http://purl.org/spar/datacite/AlternateResourceIdentifier
<http://purl.org/spar/datacite/AlternateResourceIdentifier> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.org/spar/datacite/ResourceIdentifier> ;
                                                            owl:disjointWith <http://purl.org/spar/datacite/PrimaryResourceIdentifier> ;
                                                            <http://purl.org/vocab/vann/example> """
        :my-resource
            datacite:hasIdentifier :my-resource-alt .
        :my-resource-alt a datacite:AlternateResourceIdentifier ;
            literal:hasLiteralValue \"19381256\" .
    """ ;
                                                            rdfs:comment "An identifier other than a DOI that is used as an alternative identifier to uniquely identify a resource that is the subject of the DataCite metadata record."@en ;
                                                            rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                            rdfs:label "alternate resource identifier"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "An alternate resource identifier belongs to a particular scheme, such as ISBN, specified by an individual that is a member of the class datacite:ResourceIdentifierScheme."@en .


###  http://purl.org/spar/datacite/DescriptionType
<http://purl.org/spar/datacite/DescriptionType> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                <http://purl.org/vocab/vann/example> """
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    """ ;
                                                rdfs:comment "This class permits classification of the type of description given to a resource described by the DataCite Metadata schema."@en ;
                                                rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                rdfs:label "description type"@en ;
                                                <http://www.w3.org/2004/02/skos/core#scopeNote> """
         Individual members of the class conform to the five values allowed in the DataCite controlled list, namely: 

        * datacite:abstract;
        * datacite:methods;
        * datacite:series-information;
        * datacite:table-of-content;
        * datacite:other.
    """@en .


###  http://purl.org/spar/datacite/FunderIdentifier
<http://purl.org/spar/datacite/FunderIdentifier> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifier> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                   owl:allValuesFrom <http://purl.org/spar/datacite/FunderIdentifierScheme>
                                                                 ] ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-funder-id a datacite:FunderIdentifier ;
            literal:hasLiteralValue \"\" .
    """ ;
                                                 rdfs:comment "An identifier that uniquely identities a funding agency."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                 rdfs:label "funder identifier"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A funder identifier belongs to a particular scheme, such as FundRef, specified by an individual within the class datacite:FunderIdentifierScheme."@en .


###  http://purl.org/spar/datacite/FunderIdentifierScheme
<http://purl.org/spar/datacite/FunderIdentifierScheme> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifierScheme> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/usesIdentifierScheme>
                                                                                        ] ;
                                                                         owl:someValuesFrom <http://purl.org/spar/datacite/FunderIdentifier>
                                                                       ] ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-funder-id 
            datacite:usesIdentifierScheme datacite:fundref .
    """ ;
                                                       rdfs:comment "The identifier scheme used to identify a funding agency."@en ;
                                                       rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                       rdfs:label "funder identifier scheme"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of this class. At present, the only individual of this class is datacite:fundref."@en .


###  http://purl.org/spar/datacite/Identifier
<http://purl.org/spar/datacite/Identifier> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.essepuntato.it/2010/06/literalreification/Literal> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass <http://purl.org/spar/datacite/IdentifierScheme>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/hasIdentifier>
                                                                            ] ;
                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                           ] ;
                                           rdfs:comment "An identifier that uniquely identities an entity, such as a funding agency, a person or a resource."@en ;
                                           rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                           rdfs:label "identifier"@en ;
                                           <http://www.w3.org/2004/02/skos/core#scopeNote> "An identifier belongs to a particular scheme, such as those specified by individuals of the class datacite:IdentifierScheme."@en .


###  http://purl.org/spar/datacite/IdentifierScheme
<http://purl.org/spar/datacite/IdentifierScheme> rdf:type owl:Class ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-object-id ;
            datacite:usesIdentifierScheme datacite:wikidata ;
            literal:hasLiteralValue \"Q113333457\" .
    """ ;
                                                 rdfs:comment "The identifier scheme used to identify an entity such as a funding agency, a person or a resource."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                 rdfs:label "identifier scheme"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of this class."@en .


###  http://purl.org/spar/datacite/MetadataScheme
<http://purl.org/spar/datacite/MetadataScheme> rdf:type owl:Class ;
                                               <http://purl.org/vocab/vann/example> """
        :my-resource
            cito:citesAsMetadataDocument :my-resource-metadata .
        :my-resource-metadata a fabio:MetadataDocument ;
            datacite:usesMetadataScheme datacite:spar .
    """ ;
                                               rdfs:comment "The class that describe metadata schemes used for creating a metadata document referring to a certain resource."@en ;
                                               rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                               rdfs:label "metadata scheme"@en ;
                                               rdfs:seeAlso <http://purl.org/spar/cito/citesAsMetadataDocument> ,
                                                            <http://purl.org/spar/fabio/MetadataDocument> ;
                                               <http://www.w3.org/2004/02/skos/core#scopeNote> "Neither a class for metadata documents nor a property linking a resource to its metadata document are explicitly defined in this ontology. However, we recommend to use the class fabio:MetadataDocument (from http://purl.org/spar/fabio) and cito:citesAsMetadataDocument (from http://purl.org/spar/cito) for providing such descriptions. In addition, if needed, it is possible to use the dataproperty fabio:hasURL (not included in this ontology as well) for defining the actual URL of a certain metadata scheme."@en .


###  http://purl.org/spar/datacite/OrganizationIdentifier
<http://purl.org/spar/datacite/OrganizationIdentifier> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifier> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                         owl:allValuesFrom <http://purl.org/spar/datacite/OrganizationIdentifier>
                                                                       ] ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-organization-id a datacite:OrganizationIdentifier ;
            literal:hasLiteralValue \"00wb4mk85\" .
    """ ;
                                                       rdfs:comment "An identifier that uniquely identities an individual organization."@en ;
                                                       rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                       rdfs:label "organization identifier"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "An organization identifier belongs to a particular identifier scheme, such as ISNI, specified by an individual within the class datacite:OrganizationIdentifierScheme."@en .


###  http://purl.org/spar/datacite/OrganizationIdentifierScheme
<http://purl.org/spar/datacite/OrganizationIdentifierScheme> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifierScheme> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/usesIdentifierScheme>
                                                                                              ] ;
                                                                               owl:someValuesFrom <http://purl.org/spar/datacite/OrganizationIdentifier>
                                                                             ] ;
                                                             <http://purl.org/vocab/vann/example> """
        :my-organization-id a datacite:OrganizationIdentifier ;
            datacite:usesIdentifierScheme datacite:ror .
    """ ;
                                                             rdfs:comment "The identifier scheme used to identify an organization."@en ;
                                                             rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                             rdfs:label "organization identifier scheme"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of this class."@en .


###  http://purl.org/spar/datacite/PersonalIdentifier
<http://purl.org/spar/datacite/PersonalIdentifier> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifier> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                     owl:allValuesFrom <http://purl.org/spar/datacite/PersonalIdentifierScheme>
                                                                   ] ;
                                                   <http://purl.org/vocab/vann/example> """
        :david-shotton
            datacite:hasIdentifier :david-shotton-id .
        :david-shotton-id a datacite:PersonalIdentifier ;
            literal:hasLiteralValue \"0000-0001-5506-523X\" .
    """ ;
                                                   rdfs:comment "An identifier that uniquely identifies an individual person."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                   rdfs:label "personal identifier"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "A personal identifier belongs to a particular identifier scheme, such as ORCID, specified by an individual within the class datacite:PersonalIdentifierScheme."@en .


###  http://purl.org/spar/datacite/PersonalIdentifierScheme
<http://purl.org/spar/datacite/PersonalIdentifierScheme> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.org/spar/datacite/AgentIdentifierScheme> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/usesIdentifierScheme>
                                                                                          ] ;
                                                                           owl:someValuesFrom <http://purl.org/spar/datacite/PersonalIdentifier>
                                                                         ] ;
                                                         <http://purl.org/vocab/vann/example> """
        :david-shotton-id
            datacite:usesIdentifierScheme datacite:orcid .
    """ ;
                                                         rdfs:comment "The identifier scheme used to identify a person."@en ;
                                                         rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                         rdfs:label "personal identifier scheme"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of this class."@en .


###  http://purl.org/spar/datacite/PrimaryResourceIdentifier
<http://purl.org/spar/datacite/PrimaryResourceIdentifier> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.org/spar/datacite/ResourceIdentifier> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                            owl:hasValue <http://purl.org/spar/datacite/doi>
                                                                          ] ;
                                                          <http://purl.org/vocab/vann/example> """
        :my-resource-id a datacite:PrimaryResourceIdentifier ;
            literal:hasLiteralValue \"10.1371/journal.pntd.0000228.g002.x001\" ;
            datacite:usesIdentifierScheme datacite:doi .
    """ ;
                                                          rdfs:comment "An identifier that is used as the primary identifier to uniquely identifies the primary resource that is the subject of the DataCite metadata record."@en ;
                                                          rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                          rdfs:label "primary resource identifier"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#scopeNote> "This class uses a datacite:IdentifierScheme that is restricted to datacite:doi, an individual in the datacite:ResourceIdentifierScheme." .


###  http://purl.org/spar/datacite/QualifiedRelation
<http://purl.org/spar/datacite/QualifiedRelation> rdf:type owl:Class ;
                                                  owl:equivalentClass [ owl:intersectionOf ( <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation>
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://purl.org/spar/datacite/hasRelationCharacterization> ;
                                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://purl.org/spar/datacite/hasRelationObject> ;
                                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://purl.org/spar/datacite/hasRelationSubject> ;
                                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ] ;
                                                  <http://purl.org/vocab/vann/example> """
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationSubject :my-resource ;
            datacite:hasRelationObject :my-article ;
            datacite:hasRelationCharacterization cito:isCitedBy .
    """ ;
                                                  rdfs:comment "A class representing a reified relation between two resources, allowing the assignment of a specific role or type to the connection."@en ;
                                                  rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                  rdfs:label "qualified relation"@en .


###  http://purl.org/spar/datacite/ResourceIdentifier
<http://purl.org/spar/datacite/ResourceIdentifier> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.org/spar/datacite/Identifier> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/spar/datacite/usesIdentifierScheme> ;
                                                                     owl:allValuesFrom <http://purl.org/spar/datacite/ResourceIdentifierScheme>
                                                                   ] ;
                                                   <http://purl.org/vocab/vann/example> """
        :my-resource-id a datacite:ResourceIdentifier ;
            literal:hasLiteralValue \"10.3457/1098.a45\" .
    """ ;
                                                   rdfs:comment "An identifier that is used to uniquely identify a resource."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                   rdfs:label "resource identifier"@en .


###  http://purl.org/spar/datacite/ResourceIdentifierScheme
<http://purl.org/spar/datacite/ResourceIdentifierScheme> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.org/spar/datacite/IdentifierScheme> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty [ owl:inverseOf <http://purl.org/spar/datacite/usesIdentifierScheme>
                                                                                          ] ;
                                                                           owl:someValuesFrom <http://purl.org/spar/datacite/ResourceIdentifier>
                                                                         ] ;
                                                         <http://purl.org/vocab/vann/example> """
        :my-resource-pri
            datacite:usesIdentifierScheme datacite:doi .
    """ ;
                                                         rdfs:comment "The identifier scheme used to identify a resource."@en ;
                                                         rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                         rdfs:label "resource identifier scheme"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defines as members of this class. For DataCite, the only permitted identifier scheme for the primary resource identifier is the Digital Object Identifier (datacite:doi)."@en .


###  http://purl.org/spar/datacite/RightsIdentifier
<http://purl.org/spar/datacite/RightsIdentifier> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/spar/datacite/Identifier> ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-resource-rights
            datacite:hasIdentifier :my-resource-rights-id .
        :my-resource-rights-id a datacite:RightsIdentifier ;
            literal:hasLiteralValue \"CC-BY-1.0\" .
    """ ;
                                                 rdfs:comment "An identifier that uniquely identifies a license."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                 rdfs:label "rights identifier"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A rights identifier belongs to a particular scheme, such as SPDX, specified by an individual within the class datacite:RightsIdentifierScheme."@en .


###  http://purl.org/spar/datacite/RightsIdentifierScheme
<http://purl.org/spar/datacite/RightsIdentifierScheme> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://purl.org/spar/datacite/IdentifierScheme> ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-resource-rights-id a datacite:RightsIdentifier ;
            datacite:usesIdentifierScheme datacite:spdx ;
            literal:hasLiteralValue \"CC-BY-1.0\" .
    """ ;
                                                       rdfs:comment "The identifier scheme used to identify a license."@en ;
                                                       rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                                       rdfs:label "rights identifier scheme"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Individual schemes are defined as members of this class."@en .


###  http://www.essepuntato.it/2010/06/literalreification/Literal
<http://www.essepuntato.it/2010/06/literalreification/Literal> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://purl.org/spar/datacite/abstract
<http://purl.org/spar/datacite/abstract> rdf:type owl:NamedIndividual ,
                                                  <http://purl.org/spar/datacite/DescriptionType> ;
                                         <http://purl.org/vocab/vann/example> """
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    """ ;
                                         rdfs:comment "A brief summary of a textual work, appearing at the beginning of the work and designed to act as the point-of-entry that will help the reader quickly to obtain an overview of the work's contents."@en ;
                                         rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                         rdfs:label "abstract"@en ;
                                         rdfs:seeAlso <http://purl.org/spar/fabio/Abstract> .


###  http://purl.org/spar/datacite/acm
<http://purl.org/spar/datacite/acm> rdf:type owl:NamedIndividual ,
                                             <http://purl.org/spar/datacite/PersonalIdentifierScheme> ;
                                    <http://purl.org/spar/fabio/hasURL> "https://dl.acm.org/"^^xsd:anyURI ;
                                    <http://purl.org/vocab/vann/example> """
        :silvio-peroni-id 
            datacite:usesIdentifierScheme datacite:acm ;
            literal:hasLiteralValue \"81442604750\" .
    """ ;
                                    rdfs:comment "An ACM Digital Library author ID is a unique identifier found within an ACM Author Profile Page, which consolidates an researcher's publications, citations, and metadata."@en ;
                                    rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                    rdfs:label "acm"@en ;
                                    <http://www.w3.org/2004/02/skos/core#scopeNote> "The ACM Digital Library author ID is resolvable using the following URL: https://dl.acm.org/profile/<identifier>."@en .


###  http://purl.org/spar/datacite/ark
<http://purl.org/spar/datacite/ark> rdf:type owl:NamedIndividual ,
                                             <http://purl.org/spar/datacite/ResourceIdentifierScheme> ;
                                    <http://purl.org/spar/fabio/hasURL> "https://confluence.ucop.edu/display/Curation/ARK"^^xsd:anyURI ;
                                    <http://purl.org/vocab/vann/example> """
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:ark ;
            literal:hasLiteralValue \"ark:53355/cl010066723\" .
    """ ;
                                    rdfs:comment "An Archival Resource Key (ARK) is a multi-purpose URL suited to being a persistent identifier for information objects of any type."@en ;
                                    rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                    rdfs:label "ark"@en .


###  http://purl.org/spar/datacite/arxiv
<http://purl.org/spar/datacite/arxiv> rdf:type owl:NamedIndividual ,
                                               <http://purl.org/spar/datacite/ResourceIdentifierScheme> ;
                                      <http://purl.org/spar/fabio/hasURL> "http://arxiv.org/"^^xsd:anyURI ;
                                      <http://purl.org/vocab/vann/example> """
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:arxiv ;
            literal:hasLiteralValue \"2505.13276\" .
    """ ;
                                      rdfs:comment "The ArXiv ID is a unique identifier for ArXiv (http://arxiv.org/), a open access repository of preprints."@en ;
                                      rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                      rdfs:label "arxiv"@en ;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "An ArXiv ID is resolvable using the following URL: https://arxiv.org/abs/<identifier>." .


###  http://purl.org/spar/datacite/bibcode
<http://purl.org/spar/datacite/bibcode> rdf:type owl:NamedIndividual ,
                                                 <http://purl.org/spar/datacite/ResourceIdentifierScheme> ;
                                        <http://purl.org/spar/fabio/hasURL> "https://adsabs.harvard.edu/abs_doc/help_pages/data.html"^^xsd:anyURI ;
                                        <http://purl.org/vocab/vann/example> """
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:bibcode ;
            literal:hasLiteralValue \"1974AJ.....79..819H\" .
    """ ;
                                        rdfs:comment "The Bibliographic Code (BIBCODE) is a 19 ASCII characters identifier which describes a journal article."@en ;
                                        rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                        rdfs:label "bibcode"@en ;
                                        <http://www.w3.org/2004/02/skos/core#scopeNote> """
        The format was originally adopted by the SIMBAD and NED projects, and follows the syntax \"YYYYJJJJJVVVVMPPPPA\", where:

            * YYYY: Year of publication;
            * JJJJJ: A standard abbreviation for the journal (e.g. ApJ, AJ, MNRAS, Sci, PASP, etc.). A list of abbreviations is available;
            * VVVV: The volume number (for a serial) or an abbreviation that specifies what type of publication it is (e.g. conf for conference proceedings, meet for Meeting proceedings, book for a book, coll for colloquium proceedings, proc for any other type of proceedings);
            * M: Qualifier for publication;
            * E: Electronic Abstract (usually a counter, not a page number);
            * L: Letter;
            * P: Pink page;
            * Q-Z: Unduplicating character for identical codes;
            * PPPP: Page number. Note that for page numbers greater than 9999, the page number is continued in the m column;
            * A: The first letter of the last name of the first author.
    """@en .


###  http://purl.org/spar/datacite/crossref
<http://purl.org/spar/datacite/crossref> rdf:type owl:NamedIndividual ,
                                                  <http://purl.org/spar/datacite/OrganizationIdentifierScheme> ;
                                         <http://purl.org/spar/fabio/hasURL> "https://crossref.org/"^^xsd:anyURI ;
                                         <http://purl.org/vocab/vann/example> """
        :my-organization-id 
            datacite:usesIdentifierScheme datacite:crossref ;
            literal:hasLiteralValue \"20280\" .
    """ ;
                                         rdfs:comment "The Crossref member identifier is a unique numerical ID automatically assigned to each organization when they join Crossref to manage their account and content registration."@en ;
                                         rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                         rdfs:label "crossref"@en ;
                                         <http://www.w3.org/2004/02/skos/core#scopeNote> "A Crossref member identifier is resolvable from the following URL: https://api.crossref.org/members/<identifier>."@en .


###  http://purl.org/spar/datacite/cstr
<http://purl.org/spar/datacite/cstr> rdf:type owl:NamedIndividual ,
                                              <http://purl.org/spar/datacite/ResourceIdentifierScheme> ;
                                     <http://purl.org/spar/fabio/hasURL> "https://www.cstr.cn/"^^xsd:anyURI ;
                                     <http://purl.org/vocab/vann/example> """
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:cstr ;
            literal:hasLiteralValue \"31253.11.sciencedb.j00001.00123\" .
    """ ;
                                     rdfs:comment "The Common Science and Technology Resources (CSTR) Identifier is an identifier based on the Chinese National Standard GB/T 32843—2016 “Science and technology resource identification”, providing a unique identification service for scientific data, papers, scientific institutions, researchers, scientific instruments, patents and other scientific and technological resources."@en ;
                                     rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                     rdfs:label "cstr"@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A Common Science and Technology Resources Identifier is resolvable from the following URL: https://www.cstr.cn/<identifier>."@en .


###  http://purl.org/spar/datacite/dblp
<http://purl.org/spar/datacite/dblp> rdf:type owl:NamedIndividual ,
                                              <http://purl.org/spar/datacite/PersonalIdentifierScheme> ;
                                     <http://purl.org/spar/fabio/hasURL> "https://dblp.org"^^xsd:anyURI ;
                                     <http://purl.org/vocab/vann/example> """
        :silvio-peroni-id
            datacite:usesIdentifierScheme datacite:dblp ;
            literal:hasLiteralValue \"48/1099\" .
    """ ;
                                     rdfs:comment "The DBLP author identifier is a unique key assigned to each researcher registered on DBLP."@en ;
                                     rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                     rdfs:label "dblp"@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A DBLP author identifier is resolvable from the following URL: https://dblp.org/pid/<identifier>."@en .


###  http://purl.org/spar/datacite/dblp-record
<http://purl.org/spar/datacite/dblp-record> rdf:type owl:NamedIndividual ,
                                                     <http://purl.org/spar/datacite/ResourceIdentifierScheme> ;
                                            <http://purl.org/spar/fabio/hasURL> "https://dblp.org/"^^xsd:anyURI ;
                                            <http://purl.org/vocab/vann/example> """
        :my-resource-id
            datacite:usesIdentifierScheme datacite:dblp-record ;
            literal:hasLiteralValue \"conf/semweb/BarzaghiHMP24\" .
    """ ;
                                            rdfs:comment "The DBLP publication identifier is a unique key that identifies a specific publication record, conference, or journal registered on DBLP."@en ;
                                            rdfs:isDefinedBy <http://purl.org/spar/datacite/> ;
                                            rdfs:label "dblp record"@en ;
                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "A DBLP publication identifier is resolvable from the following URL: https://dblp.org/rec/<identifier>."@en .


###  http://purl.org/spar/datacite/dia
<http://purl.org/spar/datacite/dia> rdf:type owl:NamedIndividual ,
                                             <http://purl.org/spar/datacite/PersonalIdentifierScheme> ;
                                    <http://purl.org/spar/fabio/hasURL> "http://www.surf.nl/en/themas/openonderzoek/infrastructuur/Pages/digitalauthoridentifierdai.aspx"^^xsd:anyURI ;
