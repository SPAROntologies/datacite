datacite:infouri a datacite:ResourceIdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "infouri"@en ;
    fabio:hasURL "http://info-uri.info/registry/docs/misc/faq.html"^^xsd:anyURI ;
    vann:example """
