      {
        "@language": "en",
        "@value": "is supplement of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/vocab/frbr/core#relatedEndeavour"
      }
