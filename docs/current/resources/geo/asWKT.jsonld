        "@value": "\n        :my-dataset-location a geo:Feature ;\n                geo:hasGeometry :my-dataset-location-point .\n        \n        :my-dataset-location-point a sf:Point ;\n                geo:asWKT \"POINT(20 45)\"^^geo:wktLiteral .\n        "
      }
