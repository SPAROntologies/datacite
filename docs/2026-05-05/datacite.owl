        <rdfs:label>w3id</rdfs:label>
        <skos:scopeNote xml:lang="en">It has the shape of a URL starting with &quot;https://w3id.org/&quot; plus a local identifier that completes it (e.g. &quot;https://w3id.org/changes&quot;).</skos:scopeNote>
