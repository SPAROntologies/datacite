    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/type -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/type"/>
    


    <!-- http://purl.org/spar/datacite/hasCreatorList -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasCreatorList">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/co/List"/>
        <rdfs:comment xml:lang="en">This property allows one to specify the list of the creators of a certain resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has creator list</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasDescription -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasDescription">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasDescriptionType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <vann:example>
        :my-resource
            datacite:hasDescription :my-resource-additional-info .
        :my-resource-additional-info
            literal:hasLiteralValue &quot;A textual description&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property permitting specification of an entity used to describe a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasDescriptionType -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasDescriptionType">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/hasDescription"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/spar/datacite/DescriptionType"/>
        <vann:example>
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property permitting specification of the type of description used to describe a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has description type</rdfs:label>
        <skos:scopeNote xml:lang="en">A type of description is defined as an individual of the class datacite:DescriptionType from the DataCite controlled list of Abstract (datacite:abstract), SeriesInformation (datacite:series-information), TableOfContent (datacite:table-of-content) and Other (datacite:other).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasGeneralResourceType -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasGeneralResourceType">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <vann:example>
        :my-resource
            datacite:hasGeneralResourceType dcmitype:Dataset .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property permitting specification of the general type of a resource, defined from the DataCite controlled list.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has general resource type</rdfs:label>
        <skos:scopeNote xml:lang="en">
The DataCite controlled list includes: 

- dcmitype:MovingImage;
- fabio:Book;
- fabio:BookChapter;
- dcmitype:Collection;
- fabio:LaboratoryNotebook;
- fabio:ConferencePaper;
- fabio:ConferenceProceedings;
- fabio:ResourcePaper;
- dcmitype:Dataset;
- fabio:Thesis;
- dcmitype:Event;
- dcmitype:StillImage;
- dcmitype:InteractiveResource;
- fabio:Journal;
- fabio:JournalArticle;
- fabio:Model;
- fabio:DataManagementPlan;
- dcmitype:PhysicalObject;
- fabio:ConferencePoster;
- fabio:Preprint;
- fabio:Presentation;
- fabio:ProjectPlan;
- fabio:ReportDocument;
- dcmitype:Service;
- dcmitype:Software;
- dcmitype:Sound;
- fabio:TechnicalStandard;
- fabio:Report;
- dcmitype:Text;
- fabio:Workflow;
- frbr:Endeavour.

All the prefixes used here refer to external ontologies, i.e., DC Metadata Terms (dcmitype: http://purl.org/dc/dcmitype/), FaBiO (fabio: http://purl.org/spar/fabio/), and FRBR (frbr: http://purl.org/vocab/frbr/core#).
    </skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasIdentifier -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <vann:example>
        :my-resource
            datacite:hasIdentifier :my-resource-pri .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property specifying a datacite:Identifier that provides a unique identifer for the entity (either a funder, a person or a resource).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasRelationCharacterization -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasRelationCharacterization">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <rdfs:domain rdf:resource="http://purl.org/spar/datacite/QualifiedRelation"/>
        <vann:example>
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationCharacterization cito:isCitedBy .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property defining the specific nature or type of the reified relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has relation characterization</rdfs:label>
        <skos:scopeNote xml:lang="en">This property uses as range an existing property via OWL2 punning, according to which it becomes possible to use an object property as the object of an OWL assertion. In such cases of OWL punning, the object properties are simultaneously considered both as normal object properties and also as proper named individuals of the class owl:Thing.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasRelationObject -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasRelationObject">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <rdfs:domain rdf:resource="http://purl.org/spar/datacite/QualifiedRelation"/>
        <vann:example>
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationObject :my-article .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property linking a reified relation to its object resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has relation object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/hasRelationSubject -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasRelationSubject">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <rdfs:domain rdf:resource="http://purl.org/spar/datacite/QualifiedRelation"/>
        <vann:example>
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationSubject :my-resource .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property linking a reified relation to its subject resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">has relation subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/usesIdentifierScheme -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
        <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
        <vann:example>
        :my-resource-id
            datacite:usesIdentifierScheme datacite:doi .
    </vann:example>
        <rdfs:comment xml:lang="en">An object property permitting specification of the identifier scheme used to provide the identifier for an entity (either a funder, a person or a resource).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">uses identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">An identifier scheme is defined as an individual of the class datacite:IdentifierScheme.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/datacite/usesMetadataScheme -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesMetadataScheme">
        <rdfs:range rdf:resource="http://purl.org/spar/datacite/MetadataScheme"/>
        <vann:example>
        :related-document a fabio:MetadataDocument ;
            datacite:usesMetadataScheme datacite:spar .
    </vann:example>
        <rdfs:comment xml:lang="en">The link between a metadata document and the scheme followed for creating metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">uses metadata scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/spar/fabio/hasURL -->


    <owl:DatatypeProperty rdf:about="http://purl.org/spar/fabio/hasURL"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/co/List -->


    <owl:Class rdf:about="http://purl.org/co/List"/>
    


    <!-- http://purl.org/spar/datacite/AgentIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/AgentIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/datacite/AgentIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
        <vann:example>
        :essepuntato a datacite:AgentIdentifier ;
            literal:hasLiteralValue &quot;https://github.com/essepuntato&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that uniquely identities an individual agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">agent identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">An agent identifier belongs to a particular identifier scheme, specified by an individual within the class datacite:AgentIdentifierScheme (or any of its subclasses).</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/AgentIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/AgentIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/AgentIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :silvio-peroni-id
            datacite:usesIdentifierScheme datacite:github ;
            literal:hasLiteralValue &quot;essepuntato&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify an agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">agent identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of its sub-classes.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/AlternateResourceIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/AlternateResourceIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
        <owl:disjointWith rdf:resource="http://purl.org/spar/datacite/PrimaryResourceIdentifier"/>
        <vann:example>
        :my-resource
            datacite:hasIdentifier :my-resource-alt .
        :my-resource-alt a datacite:AlternateResourceIdentifier ;
            literal:hasLiteralValue &quot;19381256&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier other than a DOI that is used as an alternative identifier to uniquely identify a resource that is the subject of the DataCite metadata record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">alternate resource identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">An alternate resource identifier belongs to a particular scheme, such as ISBN, specified by an individual that is a member of the class datacite:ResourceIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/DescriptionType -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/DescriptionType">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <vann:example>
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    </vann:example>
        <rdfs:comment xml:lang="en">This class permits classification of the type of description given to a resource described by the DataCite Metadata schema.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">description type</rdfs:label>
        <skos:scopeNote xml:lang="en">
         Individual members of the class conform to the five values allowed in the DataCite controlled list, namely: 

        * datacite:abstract;
        * datacite:methods;
        * datacite:series-information;
        * datacite:table-of-content;
        * datacite:other.
    </skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/FunderIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/FunderIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/datacite/FunderIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-funder-id a datacite:FunderIdentifier ;
            literal:hasLiteralValue &quot;&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that uniquely identities a funding agency.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">funder identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">A funder identifier belongs to a particular scheme, such as FundRef, specified by an individual within the class datacite:FunderIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/FunderIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/FunderIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifierScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/FunderIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-funder-id 
            datacite:usesIdentifierScheme datacite:fundref .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify a funding agency.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">funder identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of this class. At present, the only individual of this class is datacite:fundref.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/Identifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/Identifier">
        <rdfs:subClassOf rdf:resource="http://www.essepuntato.it/2010/06/literalreification/Literal"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An identifier that uniquely identities an entity, such as a funding agency, a person or a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">An identifier belongs to a particular scheme, such as those specified by individuals of the class datacite:IdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/IdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/IdentifierScheme">
        <vann:example>
        :my-object-id ;
            datacite:usesIdentifierScheme datacite:wikidata ;
            literal:hasLiteralValue &quot;Q113333457&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify an entity such as a funding agency, a person or a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of this class.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/MetadataScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/MetadataScheme">
        <vann:example>
        :my-resource
            cito:citesAsMetadataDocument :my-resource-metadata .
        :my-resource-metadata a fabio:MetadataDocument ;
            datacite:usesMetadataScheme datacite:spar .
    </vann:example>
        <rdfs:comment xml:lang="en">The class that describe metadata schemes used for creating a metadata document referring to a certain resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">metadata scheme</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/spar/cito/citesAsMetadataDocument"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/spar/fabio/MetadataDocument"/>
        <skos:scopeNote xml:lang="en">Neither a class for metadata documents nor a property linking a resource to its metadata document are explicitly defined in this ontology. However, we recommend to use the class fabio:MetadataDocument (from http://purl.org/spar/fabio) and cito:citesAsMetadataDocument (from http://purl.org/spar/cito) for providing such descriptions. In addition, if needed, it is possible to use the dataproperty fabio:hasURL (not included in this ontology as well) for defining the actual URL of a certain metadata scheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/OrganizationIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/OrganizationIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/datacite/OrganizationIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-organization-id a datacite:OrganizationIdentifier ;
            literal:hasLiteralValue &quot;00wb4mk85&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that uniquely identities an individual organization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">organization identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">An organization identifier belongs to a particular identifier scheme, such as ISNI, specified by an individual within the class datacite:OrganizationIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/OrganizationIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/OrganizationIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifierScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/OrganizationIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-organization-id a datacite:OrganizationIdentifier ;
            datacite:usesIdentifierScheme datacite:ror .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify an organization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">organization identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of this class.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/PersonalIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/PersonalIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :david-shotton
            datacite:hasIdentifier :david-shotton-id .
        :david-shotton-id a datacite:PersonalIdentifier ;
            literal:hasLiteralValue &quot;0000-0001-5506-523X&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that uniquely identifies an individual person.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">personal identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">A personal identifier belongs to a particular identifier scheme, such as ORCID, specified by an individual within the class datacite:PersonalIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/PersonalIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/PersonalIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/AgentIdentifierScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/PersonalIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :david-shotton-id
            datacite:usesIdentifierScheme datacite:orcid .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify a person.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">personal identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of this class.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/PrimaryResourceIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/PrimaryResourceIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:hasValue rdf:resource="http://purl.org/spar/datacite/doi"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-resource-id a datacite:PrimaryResourceIdentifier ;
            literal:hasLiteralValue &quot;10.1371/journal.pntd.0000228.g002.x001&quot; ;
            datacite:usesIdentifierScheme datacite:doi .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that is used as the primary identifier to uniquely identifies the primary resource that is the subject of the DataCite metadata record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">primary resource identifier</rdfs:label>
        <skos:scopeNote>This class uses a datacite:IdentiferScheme that is restricted to datacite:doi, an individual in the datacite:ResourceIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/QualifiedRelation -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/QualifiedRelation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasRelationCharacterization"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasRelationObject"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasRelationSubject"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <vann:example>
        :relation-dataset-article a datacite:QualifiedRelation ;
            datacite:hasRelationSubject :my-resource ;
            datacite:hasRelationObject :my-article ;
            datacite:hasRelationCharacterization cito:isCitedBy .
    </vann:example>
        <rdfs:comment xml:lang="en">A class representing a reified relation between two resources, allowing the assignment of a specific role or type to the connection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">qualified relation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/ResourceIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/ResourceIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-resource-id a datacite:ResourceIdentifier ;
            literal:hasLiteralValue &quot;10.3457/1098.a45&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that is used to uniquely identify a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">resource identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/ResourceIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/ResourceIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/spar/datacite/ResourceIdentifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:example>
        :my-resource-pri
            datacite:usesIdentifierScheme datacite:doi .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">resource identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defines as members of this class. For DataCite, the only permitted identifier scheme for the primary resource identifier is the Digital Object Identifier (datacite:doi).</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/RightsIdentifier -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/RightsIdentifier">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <vann:example>
        :my-resource-rights
            datacite:hasIdentifier :my-resource-rights-id .
        :my-resource-rights-id a datacite:RightsIdentifier ;
            literal:hasLiteralValue &quot;CC-BY-1.0&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier that uniquely identifies a license.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">rights identifier</rdfs:label>
        <skos:scopeNote xml:lang="en">A rights identifier belongs to a particular scheme, such as SPDX, specified by an individual within the class datacite:RightsIdentifierScheme.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.org/spar/datacite/RightsIdentifierScheme -->


    <owl:Class rdf:about="http://purl.org/spar/datacite/RightsIdentifierScheme">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
        <vann:example>
        :my-resource-rights-id a datacite:RightsIdentifier ;
            datacite:usesIdentifierScheme datacite:spdx ;
            literal:hasLiteralValue &quot;CC-BY-1.0&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The identifier scheme used to identify a license.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">rights identifier scheme</rdfs:label>
        <skos:scopeNote xml:lang="en">Individual schemes are defined as members of this class.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.essepuntato.it/2010/06/literalreification/Literal -->


    <owl:Class rdf:about="http://www.essepuntato.it/2010/06/literalreification/Literal"/>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation -->


    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/spar/datacite/abstract -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/abstract">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/DescriptionType"/>
        <vann:example>
        :my-resource-additional-info
            datacite:hasDescriptionType datacite:abstract .
    </vann:example>
        <rdfs:comment xml:lang="en">A brief summary of a textual work, appearing at the beginning of the work and designed to act as the point-of-entry that will help the reader quickly to obtain an overview of the work&apos;s contents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">abstract</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/spar/fabio/Abstract"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/acm -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/acm">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://dl.acm.org/</fabio:hasURL>
        <vann:example>
        :silvio-peroni-id 
            datacite:usesIdentifierScheme datacite:acm ;
            literal:hasLiteralValue &quot;81442604750&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An ACM Digital Library author ID is a unique identifier found within an ACM Author Profile Page, which consolidates an researcher&apos;s publications, citations, and metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">acm</rdfs:label>
        <skos:scopeNote xml:lang="en">The ACM Digital Library author ID is resolvable using the following URL: https://dl.acm.org/profile/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/ark -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/ark">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://confluence.ucop.edu/display/Curation/ARK</fabio:hasURL>
        <vann:example>
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:ark ;
            literal:hasLiteralValue &quot;ark:53355/cl010066723&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">An Archival Resource Key (ARK) is a multi-purpose URL suited to being a persistent identifier for information objects of any type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">ark</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/arxiv -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/arxiv">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://arxiv.org/</fabio:hasURL>
        <vann:example>
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:arxiv ;
            literal:hasLiteralValue &quot;2505.13276&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The ArXiv ID is a unique identifier for ArXiv (http://arxiv.org/), a open access repository of preprints.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">arxiv</rdfs:label>
        <skos:scopeNote>An ArXiv ID is resolvable using the following URL: https://arxiv.org/abs/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/bibcode -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/bibcode">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://adsabs.harvard.edu/abs_doc/help_pages/data.html</fabio:hasURL>
        <vann:example>
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:bibcode ;
            literal:hasLiteralValue &quot;1974AJ.....79..819H&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Bibliographic Code (BIBCODE) is a 19 ASCII characters identifier which describes a journal article.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">bibcode</rdfs:label>
        <skos:scopeNote xml:lang="en">
        The format was originally adopted by the SIMBAD and NED projects, and follows the syntax &quot;YYYYJJJJJVVVVMPPPPA&quot;, where:

            * YYYY: Year of publication;
            * JJJJJ: A standard abbreviation for the journal (e.g. ApJ, AJ, MNRAS, Sci, PASP, etc.). A list of abbreviations is available;
            * VVVV: The volume number (for a serial) or an abbreviation that specifies what type of publication it is (e.g. conf for conference proceedings, meet for Meeting proceedings, book for a book, coll for colloquium proceedings, proc for any other type of proceedings);
            * M: Qualifier for publication;
            * E: Electronic Abstract (usually a counter, not a page number);
            * L: Letter;
            * P: Pink page;
            * Q-Z: Unduplicating character for identical codes;
            * PPPP: Page number. Note that for page numbers greater than 9999, the page number is continued in the m column;
            * A: The first letter of the last name of the first author.
    </skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/crossref -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/crossref">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/OrganizationIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://crossref.org/</fabio:hasURL>
        <vann:example>
        :my-organization-id 
            datacite:usesIdentifierScheme datacite:crossref ;
            literal:hasLiteralValue &quot;20280&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Crossref member identifier is a unique numerical ID automatically assigned to each organization when they join Crossref to manage their account and content registration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">crossref</rdfs:label>
        <skos:scopeNote xml:lang="en">A Crossref member identifier is resolvable from the following URL: https://api.crossref.org/members/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/cstr -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/cstr">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cstr.cn/</fabio:hasURL>
        <vann:example>
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:cstr ;
            literal:hasLiteralValue &quot;31253.11.sciencedb.j00001.00123&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Common Science and Technology Resources (CSTR) Identifier is an identifier based on the Chinese National Standard GB/T 32843—2016 “Science and technology resource identification”, providing a unique identification service for scientific data, papers, scientific institutions, researchers, scientific instruments, patents and other scientific and technological resources.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">cstr</rdfs:label>
        <skos:scopeNote xml:lang="en">A Common Science and Technology Resources Identifier is resolvable from the following URL: https://www.cstr.cn/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/dblp -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/dblp">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://dblp.org</fabio:hasURL>
        <vann:example>
        :silvio-peroni-id
            datacite:usesIdentifierScheme datacite:dblp ;
            literal:hasLiteralValue &quot;48/1099&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The DBLP author identifier is a unique key assigned to each researcher registered on DBLP.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">dblp</rdfs:label>
        <skos:scopeNote xml:lang="en">A DBLP author identifier is resolvable from the following URL: https://dblp.org/pid/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/dblp-record -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/dblp-record">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://dblp.org/</fabio:hasURL>
        <vann:example>
        :my-resource-id
            datacite:usesIdentifierScheme datacite:dblp-record ;
            literal:hasLiteralValue &quot;conf/semweb/BarzaghiHMP24&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The DBLP publication identifier is a unique key that identifies a specific publication record, conference, or journal registered on DBLP.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">dblp record</rdfs:label>
        <skos:scopeNote xml:lang="en">A DBLP publication identifier is resolvable from the following URL: https://dblp.org/rec/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/dia -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/dia">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.surf.nl/en/themas/openonderzoek/infrastructuur/Pages/digitalauthoridentifierdai.aspx</fabio:hasURL>
        <rdfs:comment xml:lang="en">The Digital Author Identification system assigns a unique number to all authors in the Netherlands research system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">dia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/dnb -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/dnb">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://d-nb.info/</fabio:hasURL>
        <vann:example>
        :my-resource-id
            datacite:usesIdentifierScheme datacite:dnb ;
            literal:hasLiteralValue &quot;gnd/7749153-1&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Deutsche Nationalbibliothek (DNB) catalogue number is a unique identifier assigned to every entry in the DNB catalogue.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">dnb</rdfs:label>
        <skos:scopeNote xml:lang="en">A DNB catalogue number is resolvable from the following URL: https://d-nb.info/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/doi -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/doi">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.doi.org/</fabio:hasURL>
        <vann:example>
        :my-resource-id 
            datacite:usesIdentifierScheme datacite:doi ;
            literal:hasLiteralValue &quot;10.1007/978-3-031-77847-6_11&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Digital Object Identier (DOI) is a unique identifier assigned to identify digital objects.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">doi</rdfs:label>
        <skos:scopeNote xml:lang="en">A DOI is resolvable from the following URL: http://www.doi.org/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/ean13 -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/ean13">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.gs1.org/</fabio:hasURL>
        <vann:example>
        :my-resource-id
            datacite:usesIdentifierScheme datacite:ean13 ;
            literal:hasLiteralValue &quot;4003994155486&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The International Article Number is a unique 13-digit barcode standard used worldwide to identify retail products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">ean13</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/EAN13"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/eissn -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/eissn">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/ResourceIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.issn.org/</fabio:hasURL>
        <vann:example>
        :my-resource-id
            datacite:usesIdentifierScheme datacite:eissn ;
            literal:hasLiteralValue &quot;1460-2105&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The Electronic International Standard Serial Number (eISSN) is an eight-digit identifier specifically for electronic versions of serials, such as online journals, databases, or websites.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">eissn</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/fundref -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/fundref">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/FunderIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.crossref.org/fundref/index.html</fabio:hasURL>
        <vann:example>
        :my-funder-id
            datacite:usesIdentifierScheme datacite:fundref ;
            literal:hasLiteralValue &quot;501100000831&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The FundRef identifier is a unique code assigned by Fundref, a collaborative pilot project of scholarly publishers and funding agencies, facilitated by CrossRef, to provide a standard way of identifying and reporting funding sources for published scholarly research.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">fundref</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/gepris -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/gepris">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://gepris.dfg.de</fabio:hasURL>
        <vann:example>
        :david-aitken-id
            datacite:usesIdentifierScheme datacite:gepris ;
            literal:hasLiteralValue &quot;209346727&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The GEPRIS person identifier is a unique, numerical identifier assigned to researchers and investigators in the GEPRIS database.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">gepris</rdfs:label>
        <skos:scopeNote xml:lang="en">A GEPRIS person identifier is resolvable from the following URL: http://gepris.dfg.de/gepris/person/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/github -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/github">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/AgentIdentifierScheme"/>
        <fabio:hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/</fabio:hasURL>
        <vann:example>
        :silvio-peroni-id
            datacite:usesIdentifierScheme datacite:github ;
            literal:hasLiteralValue &quot;essepuntato&quot; .
    </vann:example>
        <rdfs:comment xml:lang="en">The GitHub username is a unique identifier assigned to GitHub users.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
        <rdfs:label xml:lang="en">github</rdfs:label>
        <skos:scopeNote xml:lang="en">A GitHub username is resolvable from the following URL: https://github.com/&lt;identifier&gt;.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spar/datacite/gitlab -->


    <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/gitlab">
        <rdf:type rdf:resource="http://purl.org/spar/datacite/PersonalIdentifierScheme"/>
