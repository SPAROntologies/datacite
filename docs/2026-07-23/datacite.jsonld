        "@value": "https://gnd.network/"
      }
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-resource-id \n                datacite:usesIdentifierScheme datacite:gnd ;\n                literal:hasLiteralValue \"7749153-1\" .\n        "
