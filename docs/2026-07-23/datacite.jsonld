      {
        "@language": "en",
        "@value": "qualified relation"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:n16082fa6811145e08dfaeb8890637028b39"
      }
    ],
